                    tibex:xpdlId="ccd90d15-2589-48bb-8d00-758d959dfbf2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseXmlToJDBCQuery"/>
