                    <bpws:sources>
                        <bpws:source linkName="CheckContrctEmpToJDBCUpdate_OnContractEmpCount5">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckContrctEmp/Record[1]/employee_exists eq 0 and $CheckContrctEmp/Record[1]/count_of_on_contract_employees&lt;5" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckContrctEmp/Record[1]/employee_exists eq 0 and $CheckContrctEmp/Record[1]/count_of_on_contract_employees<5]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckContrctEmpToWriteFile_OnContractEmpCount5">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckContrctEmp/Record[1]/employee_exists eq 0 and $CheckContrctEmp/Record[1]/count_of_on_contract_employees >= 5" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckContrctEmp/Record[1]/employee_exists eq 0 and $CheckContrctEmp/Record[1]/count_of_on_contract_employees >= 5]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckContrctEmpToWriteFile_employeealreadyexists">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckContrctEmp/Record[1]/employee_exists eq 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckContrctEmp/Record[1]/employee_exists eq 1]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
