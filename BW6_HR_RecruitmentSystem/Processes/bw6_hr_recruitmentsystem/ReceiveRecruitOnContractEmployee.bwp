    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="JMSReceiveMessageToParseXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXmlToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="CheckContrctEmpToJDBCUpdate_OnContractEmpCount5"
                    tibex:label="OnContractEmpCount &lt; 5" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="CheckContrctEmpToWriteFile_OnContractEmpCount5"
                    tibex:label="OnContractEmpCount >= 5" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCUpdateToWriteFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WriteLog1ToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckEmpToRenderdata" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderdataToJMSSendMessage" tibex:linkType="SUCCESS"/>
                <bpws:link name="JMSSendMessageToWriteFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WriteLog2ToConfirm" tibex:linkType="SUCCESS"/>
                <bpws:link name="WriteLog3ToConfirm" tibex:linkType="SUCCESS"/>
                <bpws:link name="ConfirmToExit" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="CheckContrctEmpToWriteFile_employeealreadyexists"
                    tibex:label="employee already exists" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="WriteFileToConfirm" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="JMSReceiveMessage"
                    tibex:xpdlId="10a3025a-f748-4850-a555-c23d6ce4d196"
                    variable="JMSReceiveMessage" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="JMSReceiveMessageToParseXml"/>
                    </bpws:sources>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.jms.receive"
                            version="6.0.0.20132205"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiverEventSource"/>
                                    <value ackMode="Client"
                                    connectionReference="jmsConnection"
                                    destinationName="hiring"
                                    maxSessions="1"
                                    messageSelector="CandidateType='OnContract'"
                                    messagingStyle="Queue"
                                    receiveTimeout="2" xsi:type="jms:JMSReceiverEventSource"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
