            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/OnRollEmployee&quot; xmlns:tns1=&quot;http://www.example.org/RecruitingCandidate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;CheckEmp&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;tns:Employee_Details>&lt;tns:Employee_id>&lt;xsl:value-of select=&quot;$CheckEmp/Record[1]/Employee_id&quot;/>&lt;/tns:Employee_id>&lt;tns:Emp_Name>&lt;xsl:value-of select=&quot;$CheckEmp/Record[1]/Employee_NAME&quot;/>&lt;/tns:Emp_Name>&lt;tns:Salary>&lt;xsl:value-of select=&quot;$CheckEmp/Record[1]/salary&quot;/>&lt;/tns:Salary>&lt;xsl:for-each select=&quot;$ParseXml/tns1:Candidate-Address&quot;>&lt;tns:employee_address>&lt;tns:Street>&lt;xsl:value-of select=&quot;tns1:Street&quot;/>&lt;/tns:Street>&lt;tns:Lane_No>&lt;xsl:value-of select=&quot;tns1:LaneNo&quot;/>&lt;/tns:Lane_No>&lt;tns:City>&lt;xsl:value-of select=&quot;tns1:City&quot;/>&lt;/tns:City>&lt;tns:Pincode>&lt;xsl:value-of select=&quot;tns1:Pincode&quot;/>&lt;/tns:Pincode>&lt;tns:Country>&lt;xsl:value-of select=&quot;tns1:Country&quot;/>&lt;/tns:Country>&lt;/tns:employee_address>&lt;/xsl:for-each>&lt;/tns:Employee_Details>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RenderXml-input" name="RenderXml"
                    outputVariable="RenderXml"
                    tibex:xpdlId="be926979-e32b-4536-8885-99b577cecdb9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
